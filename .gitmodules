# Use the zoompilot opendbc fork. Changes to this file make submodule sync refresh
# legacy URLs. panda and msgq point at zoompilot forks until sunnypilot/panda#128 and
# sunnypilot/msgq#36 merge; go back to sunnyhaibin/panda and sunnypilot/msgq then.
[submodule "panda"]
  path = panda
  url = https://github.com/zoompilot/panda.git
[submodule "opendbc"]
  path = opendbc_repo
  url = https://github.com/zoompilot/opendbc.git
[submodule "jetlink"]
  path = jetlink_repo
  url = https://github.com/zoompilot/jetlink.git
[submodule "msgq"]
  path = msgq_repo
  url = https://github.com/zoompilot/msgq.git
[submodule "rednose_repo"]
  path = rednose_repo
  url = https://github.com/commaai/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = https://github.com/commaai/teleoprtc
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/sunnypilot/tinygrad.git
[submodule "sunnypilot/neural_network_data"]
	path = openpilot/sunnypilot/neural_network_data
  url = https://github.com/sunnypilot/neural-network-data.git

