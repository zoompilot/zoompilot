# The comma-side warp JIT jetlink's large model runs, as a build product.
#
# jetlink runs `warp` on the comma and `run_policy` on the Jetson, and upstream
# no longer ships a standalone warp JIT (#38684 fused warp and policy). Built
# here like dm_warp_*.pkl in modeld/SConscript: launch_chffrplus.sh runs
# build.py before manager, so a tinygrad bump has a fresh warp before ignition,
# and a prebuilt release carries one for every camera it installs on. Nothing
# compiles one at runtime; a device without a warp runs the small model.
import glob
import os
import sys

from SCons.Script import Action

Import('env', 'arch', 'camera_configs')

basedir = env.Dir("#").abspath
jetlink_repo = env.Dir("#jetlink_repo").abspath
capture = os.path.join(jetlink_repo, 'jetlink', 'openpilot', 'warp.py')

# comma GPU only: the pickle is captured against Device.DEFAULT and only modeld
# on the device loads one. And only with a jetlink checked out that has the
# capture: an empty jetlink_repo, or an older one, builds nothing here rather
# than failing the build on a missing source
if arch == 'comma_arm64' and os.path.isfile(capture):
  from openpilot.common.transformations.model import MEDMODEL_INPUT_SIZE
  from openpilot.sunnypilot import jetlink_adapter

  # jetlink on the build's path by its checkout: the prebuilt runner makes no
  # `jetlink` link at the root as launch_chffrplus.sh does. Last, so nothing
  # else in the submodule shadows a module of the build's own
  lenv = env.Clone(ENV={**env['ENV'], 'PYTHONPATH': os.pathsep.join([env['ENV']['PYTHONPATH'], jetlink_repo])})

  # camera_configs is modeld/SConscript's: a source build's own camera, or every
  # one a prebuilt installs on. The comma four runner's release once gave a 3X
  # no warp and the small model for good
  model_w, model_h = MEDMODEL_INPUT_SIZE
  prebuilt = bool(os.getenv('PREBUILT_ALL_CAMERAS'))

  tinygrad_files = ["#" + x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**",
                                               recursive=True, root_dir=basedir)
                    if 'pycache' not in x and os.path.isfile(os.path.join(basedir, x))]
  script_files = [
    File(capture),                                           # the capture, and call_warp, which names the inputs
    File("#openpilot/sunnypilot/jetlink_adapter/__init__.py"),  # make_warp, and where the warp goes
    File("#openpilot/selfdrive/modeld/compile_modeld.py"),   # comma's warp graph
    File("#openpilot/system/camerad/cameras/nv12_info.py"),  # the frame layout the graph indexes
  ]

  # the lossless warp (Wi-Fi) also makes the frame's MED errors in its graph,
  # beside the plain one under jetlink's name for it. jetlink last on the path
  # here too
  lossless_capture = os.path.join(jetlink_repo, 'jetlink', 'openpilot', 'lossless.py')
  lossless_path = None
  if os.path.isfile(lossless_capture):
    sys.path.append(jetlink_repo)
    from jetlink.openpilot.warp import lossless_path
  lossless_files = [File(lossless_capture), File(os.path.join(jetlink_repo, 'jetlink', 'lossless.py'))]

  for cam_w, cam_h in camera_configs:
    # the target is the path modeld opens, from the adapter, so the two cannot drift
    pkl = str(jetlink_adapter.warp_path(cam_w, cam_h, model_w, model_h))
    # no tinygrad flags, unlike dm_warp: the bare-environment warp is what the
    # parity and timing numbers were measured against. On a source build '-'
    # ignores the exit status: every device builds this, link on or not, so a
    # failed compile must not fail the build. It leaves no pickle, modeld stays
    # on the small model, the link's alert says why, and the next build tries
    # again. A release fails here instead: it installs on devices that never
    # build
    cmd = (f'{"" if prebuilt else "-"}python3 -m jetlink.openpilot.warp --adapter {jetlink_adapter.__name__} '
           f'--camera {cam_w}x{cam_h} --model {model_w}x{model_h} --output {pkl}')
    lenv.Command(pkl, tinygrad_files + script_files, Action(cmd, "  [JETLINK WARP] $TARGET"))
    if lossless_path is not None:
      lossless_pkl = str(lossless_path(pkl))
      cmd = (f'{"" if prebuilt else "-"}python3 -m jetlink.openpilot.warp --adapter {jetlink_adapter.__name__} '
             f'--camera {cam_w}x{cam_h} --model {model_w}x{model_h} --output {lossless_pkl} --lossless')
      lenv.Command(lossless_pkl, tinygrad_files + script_files + lossless_files, Action(cmd, "  [JETLINK WARP] $TARGET"))
